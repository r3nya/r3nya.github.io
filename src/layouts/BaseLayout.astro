---
import '../styles/global.css';
import './BaseLayout.css';
import { siteMeta } from '../site';
import type { Locale } from '../i18n/config';

interface Props {
  title?: string;
  lang?: Locale;
}

const { title = 'Andrey Makarov aka r3nya', lang = 'en' }: Props = Astro.props;
---

<!doctype html>
<html lang={lang} data-lang={lang} class="base-layout">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={siteMeta.description} />
    <meta name="author" content={siteMeta.author} />
    <meta name="theme-color" content={siteMeta.themeColor} />
    <meta name="yandex-verification" content={siteMeta.yandexVerification} />

    <!-- Open Graph meta tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteMeta.openGraphDescription} />
    <meta property="og:image" content={siteMeta.profile.avatar} />
    <meta property="og:type" content="profile" />
    <meta property="profile:first_name" content={siteMeta.profile.firstName} />
    <meta property="profile:last_name" content={siteMeta.profile.lastName} />
    <meta property="profile:username" content={siteMeta.profile.username} />
    <meta property="profile:gender" content={siteMeta.profile.gender} />

    <!-- Icons and manifest -->
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link
      rel="mask-icon"
      href="/safari-pinned-tab.svg"
      color={siteMeta.safariPinnedTabColor}
    />

    <!-- No external stylesheet link; Tailwind v4 is bundled via global.css -->
  </head>
  <body class="base-layout__body">
    <a href="#main-content" class="base-layout__skip-link">Skip to content</a>
    <div class="base-layout__container">
      <main
        id="main-content"
        role="main"
        data-testid="main"
        class="base-layout__main"
      >
        <slot />
      </main>
    </div>
  </body>
</html>
