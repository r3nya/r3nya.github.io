---
import { locales, defaultLocale } from '@/i18n/config';
import type { Locale } from '@/i18n/config';

interface Props {
  lang: Locale;
}
const { lang: currentLang } = Astro.props;
const { origin, pathname } = Astro.url;

let basePath = pathname;
if (currentLang !== defaultLocale) {
  basePath = pathname.replace(new RegExp(`^/${currentLang}`), '');
}
if (basePath === '') {
  basePath = '/';
}

const finalBasePath = basePath === '/' ? '' : basePath;
const defaultHref = `${origin}${finalBasePath}`;
---
{locales.map(lang => {
  const langPath = lang === defaultLocale ? '' : `/${lang}`;
  const href = `${origin}${langPath}${finalBasePath}`;
  return <link rel="alternate" hreflang={lang} href={href} />;
})}
<link rel="alternate" hreflang="x-default" href={defaultHref} />
