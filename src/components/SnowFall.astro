---
import './SnowFall.css';

interface Props {
  pauseLabel?: string;
}

const { pauseLabel = 'Pause snow' }: Props = Astro.props;
const enableSnowFall =
  (import.meta.env.PUBLIC_SNOW_FALL_ENABLED ?? 'false') === 'true';
---

{enableSnowFall && (
  <>
    <snow-fall class="snow-fall" count="100" aria-hidden="true" />
    <button
      type="button"
      class="snow-fall__toggle"
      data-snow-toggle
      aria-label={pauseLabel}
      aria-pressed="false"
      hidden
    >
      <span aria-hidden="true">❄</span>
    </button>
    <script src="../scripts/snow-fall.ts"></script>
  </>
)}
