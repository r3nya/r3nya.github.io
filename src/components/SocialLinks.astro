---
import './SocialLinks.css';
import Icon from './Icon.astro';
import type { Messages } from '../i18n/messages';

interface Props {
  links: Messages['links'];
}

const { links }: Props = Astro.props;
---

<section
  class="social-links"
  role="navigation"
  aria-label="Social links"
  data-section="links"
>
  {
    links.map((link) => (
      <a
        href={link.url}
        class="social-links__link group"
        aria-label={link.title}
        data-link={link.icon}
        rel="me noopener noreferrer"
        target="_blank"
      >
        <Icon name={link.icon} />
        <span class="social-links__title">{link.title}</span>
      </a>
    ))
  }
</section>
