---
import './SocialLinks.css';
import type { Messages } from '@/i18n/messages';

interface Props {
  links: Messages['links'];
  label: string;
}

const { links, label }: Props = Astro.props;
---

<nav class="social-links" aria-label={label} data-section="links">
  {links.map((link) => (
    <a
      href={link.url}
      class="social-links__link group"
      rel="me noopener noreferrer"
      target="_blank"
    >
      <span class="social-links__title">{link.title}</span>
      <span class="social-links__arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  ))}
</nav>
