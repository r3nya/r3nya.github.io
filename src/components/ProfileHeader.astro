---
import './ProfileHeader.css';
import { siteMeta } from '@/config/site';

interface Props {
  name: string;
  headline: string;
  aliasLabel?: string;
}

const { name, headline, aliasLabel = 'Also known as' }: Props = Astro.props;
const headlineMatch = headline.match(
  /^(.*?)(\s+)(\p{Extended_Pictographic}(?:\u200D\p{Extended_Pictographic}|\uFE0F)*)$/u,
);
---

<header class="profile-header">
  <span class="profile-header__alias">
    <button
      type="button"
      class="profile-header__nickname"
      aria-describedby="profile-alias-tooltip"
      aria-expanded="false"
    >
      {siteMeta.profile.username}
    </button>
    <span
      id="profile-alias-tooltip"
      class="profile-header__tooltip"
      role="tooltip"
    >
      {aliasLabel}
    </span>
  </span>
  <h1 class="profile-header__title">{name}</h1>
  <p class="profile-header__headline">
    {headlineMatch ? (
      <>
        {headlineMatch[1]}
        {headlineMatch[2]}
        <span aria-hidden="true">{headlineMatch[3]}</span>
      </>
    ) : (
      headline
    )}
  </p>
</header>

<script src="../scripts/nickname-tooltip.ts"></script>
