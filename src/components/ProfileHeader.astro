---
import './ProfileHeader.css';
import { siteMeta } from '@/config/site';

interface Props {
  name: string;
  headline: string;
  aliasLabel?: string;
}

const { name, headline, aliasLabel = 'Also known as' }: Props = Astro.props;
---

<header class="profile-header">
  <span class="profile-header__alias">
    <span
      class="profile-header__nickname"
      tabindex="0"
      aria-describedby="profile-alias-tooltip">{siteMeta.profile.username}</span
    >
    <span
      id="profile-alias-tooltip"
      class="profile-header__tooltip"
      role="tooltip">{aliasLabel}</span
    >
  </span>
  <h1 class="profile-header__title">{name}</h1>
  <h2 class="profile-header__headline">{headline}</h2>
</header>

<script>
  document.addEventListener('keydown', (event: KeyboardEvent): void => {
    if (event.key !== 'Escape') return;
    document
      .querySelectorAll<HTMLElement>(
        '.profile-header__alias:hover, .profile-header__alias:focus-within',
      )
      .forEach((alias): void => {
        alias.dataset.dismissed = 'true';
      });
  });

  function restoreTooltip(event: FocusEvent | PointerEvent): void {
    if (!(event.target instanceof Element)) return;
    const alias = event.target.closest<HTMLElement>('.profile-header__alias');
    if (
      !alias ||
      (event.relatedTarget instanceof Node &&
        alias.contains(event.relatedTarget))
    )
      return;
    delete alias.dataset.dismissed;
  }

  document.addEventListener('pointerover', restoreTooltip);
  document.addEventListener('focusin', restoreTooltip);
</script>
