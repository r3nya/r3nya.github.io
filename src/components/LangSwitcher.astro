---
import './LangSwitcher.css';
import type { Locale } from '@/i18n/config';
import { locales, defaultLocale } from '@/i18n/config';
import { messages } from '@/i18n/messages';

interface Props {
  current: Locale;
}

const { current }: Props = Astro.props;
---

<nav
  aria-label={messages[current].language_switcher}
  class="lang-switcher"
  data-testid="lang-switcher"
>
  <ul role="list" class="lang-switcher__list">
    {locales.map((code) => (
      <li role="listitem">
        {code === current ? (
          <span
            class="lang-switcher__current"
            aria-current="true"
            data-lang={code}
          >
            {code}
          </span>
        ) : (
          <a
            class="lang-switcher__link"
            href={code === defaultLocale ? '/' : `/${code}/`}
            lang={code}
            hreflang={code}
            data-lang={code}
            data-astro-prefetch="hover"
          >
            {code}
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>
