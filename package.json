{
  "name": "new_home_page",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:e2e": "node --test e2e-tests/*.js",
    "test:unit": "vitest",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:visual:update": "vitest run --config vitest.visual.config.ts -u"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "astro": "^6.2.2",
    "astro-compress": "^2.4.1",
    "autoprefixer": "10.5.0",
    "happy-dom": "^20.9.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.2.4",
    "vitest": "^4.1.5"
  },
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.4",
    "@zachleat/snow-fall": "^1.0.3"
  }
}
