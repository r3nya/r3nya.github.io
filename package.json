{
  "name": "new_home_page",
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:e2e": "node --test e2e-tests/*.js",
    "test:unit": "vitest",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:visual:update": "vitest run --config vitest.visual.config.ts -u"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/browser-playwright": "4.1.9",
    "astro": "^7.4.2",
    "astro-compress": "^2.4.3",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "pnpm": ">=11.0.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@zachleat/snow-fall": "^1.0.3"
  }
}
